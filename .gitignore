# Real journals and generated documents must never be committed.
*.xlsx
*.xlsm
*.xls
*.xlsb
*.zip
*.pdf

# Local/private test material and outputs.
private/
local-tests/
test-output/
output/
temp/
uploads/
*.log

# OS/editor noise.
.DS_Store
Thumbs.db
.vscode/
.idea/

# Python/Node leftovers (the app itself has no runtime dependency on them).
__pycache__/
*.pyc
node_modules/
